<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Avalonia WebView component enables embedding web content in Avalonia applications for use cases like documentation, dashboards, and interactive content.</Description>
    <DefineConstants>$(DefineConstants);AVALONIA</DefineConstants>
    <RootNamespace>Avalonia.Controls</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <Version>12.0.1-libreguard.1</Version>
    <AssemblyVersion>12.0.1.0</AssemblyVersion>
    <FileVersion>12.0.1.1</FileVersion>
    <InformationalVersion>12.0.1-libreguard.1+8ae0a848102ad68a7cff54c48712871f78df7b9b</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avalonia.Controls.WebView.Core\Avalonia.Controls.WebView.Core.csproj" />
  </ItemGroup>
</Project>
