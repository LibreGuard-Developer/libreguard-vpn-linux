<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Libreguard.Vpn.Linux.Views.ExitConfirmationWindow"
        Title="Close LibreGuard VPN?"
        Width="440"
        Height="260"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Classes="modal">
    <StackPanel Spacing="0">
      <TextBlock Text="Close LibreGuard VPN?" Classes="heading-large" Margin="0,0,0,12" />
      <TextBlock Text="Closing LibreGuard now will disconnect the active VPN tunnel and remove LibreGuard's NetworkManager VPN profiles from this machine." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,24" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Classes="secondary" Content="Cancel" Click="HandleCancelClick" />
        <Button Grid.Column="1" Classes="destructive" Content="Disconnect and Exit" HorizontalContentAlignment="Center" Click="HandleConfirmClick" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
