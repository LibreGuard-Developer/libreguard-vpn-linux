<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Libreguard.Vpn.Linux.Views.TwoFactorDisableConfirmationWindow"
        Title="LibreGuard VPN - Disable 2FA"
        Width="420"
        Height="260"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Classes="modal">
    <StackPanel Spacing="0">
      <TextBlock Text="Disable Two-Factor Authentication" Classes="heading-large" Margin="0,0,0,12" />
      <TextBlock Text="Turning this off removes the extra verification step from your account. You can enable it again later." Classes="muted" TextWrapping="Wrap" Margin="0,0,0,24" />
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
        <Button Classes="secondary" Content="Cancel" Click="HandleCancelClick" />
        <Button Grid.Column="1" Classes="destructive" Content="Disable 2FA" HorizontalContentAlignment="Center" Click="HandleConfirmClick" />
      </Grid>
    </StackPanel>
  </Border>
</Window>
